---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const exts = [...new Set(allPosts.map((p) => p.data.ext))];

function fmtDate(d: Date) {
  return d.toLocaleDateString('en-US', { month: '2-digit', day: '2-digit', year: 'numeric' });
}
---
<BaseLayout title="MOON COMPUTER.SPACE">
  <div class="wrap">
    <section class="hero">
      <span class="sparkle" style="top:8px; right:14%;">✦</span>
      <span class="sparkle" style="bottom:18px; right:2%; font-size:10px;">✦</span>
      <p class="eyebrow">// found files</p>
      <h1>A computer in the woods. You feel the glow under your skin.</h1>
    </section>

    <div class="filters" id="filters">
      <a href="#" class="filter-btn active" data-ext="all">ALL</a>
      {exts.map((ext) => (
        <a href="#" class="filter-btn" data-ext={ext}>.{ext.toUpperCase()}</a>
      ))}
    </div>

    <div class="listing" id="listing">
      {allPosts.map((post) => (
        <a href={`/files/${post.slug}`} class="entry" data-ext={post.data.ext}>
          <span class="thumb" aria-hidden="true" transition:name={`post-image-${post.slug}`}>
            {post.data.image ? <img src={post.data.image} alt="" loading="lazy" /> : `.${post.data.ext.toUpperCase()}`}
          </span>
          <span class="entry-body">
            <p class="entry-title">{post.data.title}<span class="ext">.{post.data.ext}</span></p>
            <p class="entry-excerpt">{post.data.excerpt}</p>
          </span>
          <span class="entry-date">{fmtDate(post.data.pubDate)}</span>
        </a>
      ))}
    </div>

    <div class="report">
      <span>&gt; anomalous activity to record?</span>
      <a href="/contact" class="report-btn">SUBMIT REPORT_</a>
    </div>
  </div>
</BaseLayout>

<script>
  const filtersEl = document.getElementById('filters');
  const entries = Array.from(document.querySelectorAll('.entry'));

  filtersEl?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.filter-btn') as HTMLElement | null;
    if (!btn) return;
    e.preventDefault();
    filtersEl.querySelectorAll('.filter-btn').forEach((b) => b.classList.remove('active'));
    btn.classList.add('active');
    const ext = btn.dataset.ext;
    entries.forEach((entry) => {
      const el = entry as HTMLElement;
      el.style.display = ext === 'all' || el.dataset.ext === ext ? '' : 'none';
    });
  });
</script>
