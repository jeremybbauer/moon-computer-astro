---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const exts = [...new Set(allPosts.map((p) => p.data.ext))];

function fmtDate(d: Date) {
  return d.toLocaleDateString('en-US', { month: '2-digit', day: '2-digit', year: 'numeric' });
}
---
<BaseLayout title="MOON COMPUTER.SPACE">
  <div class="wrap">
    <section class="hero">
      <span class="sparkle" style="top:8px; right:14%; animation-delay:0s;">✦</span>
<span class="sparkle" style="bottom:18px; right:2%; font-size:10px; animation-delay:1.4s;">✦</span>
      <p class="eyebrow">// found files</p>
      <h1>A computer in the woods whose glow you feel under your skin</h1>
    </section>

    <div class="filters" id="filters">
      <a href="#" class="filter-btn active" data-ext="all">ALL</a>
      {exts.map((ext) => (
        <a href="#" class="filter-btn" data-ext={ext}>.{ext.toUpperCase()}</a>
      ))}
    </div>

    <div class="listing" id="listing">
      {allPosts.map((post) => (
        <a href={`/files/${post.slug}`} class="entry" data-ext={post.data.ext}>
          <span class="thumb" aria-hidden="true" transition:name={`post-image-${post.slug}`}>
            {post.data.image ? <img src={post.data.image} alt="" loading="lazy" /> : `.${post.data.ext.toUpperCase()}`}
          </span>
          <span class="entry-body">
            <p class="entry-title">{post.data.title}<span class="ext">.{post.data.ext}</span></p>
            <p class="entry-excerpt">{post.data.excerpt}</p>
          </span>
          <span class="entry-date">{fmtDate(post.data.pubDate)}</span>
        </a>
      ))}
    </div>
      <div class="load-more-wrap" id="loadMoreWrap">
      <button class="load-more-btn" id="loadMoreBtn">LOAD MORE_</button>
    </div>
    <div class="report">
      <span>&gt; anomalous activity to record?</span>
      <a href="/contact" class="report-btn">SUBMIT REPORT_</a>
    </div>
  </div>
</BaseLayout>

<script>
  document.addEventListener('astro:page-load', () => {
    console.log('page-load fired, entries found:',
  document.querySelectorALL('.entry').length);
    const PAGE_SIZE = 10;
    const filtersEl = document.getElementById('filters');
    const listingEl = document.getElementById('listing');
    const loadMoreWrap = document.getElementById('loadMoreWrap');
    const loadMoreBtn = document.getElementById('loadMoreBtn');
    const entries = Array.from(document.querySelectorAll('.entry')) as HTMLElement[];

    let currentExt = 'all';
    let visibleCount = PAGE_SIZE;

    function matches(el: HTMLElement) {
      return currentExt === 'all' || el.dataset.ext === currentExt;
    }

    function render() {
      const matching = entries.filter(matches);
      entries.forEach((el) => { el.style.display = 'none'; });
      matching.slice(0, visibleCount).forEach((el) => { el.style.display = ''; });
      if (loadMoreWrap) {
        loadMoreWrap.style.display = matching.length > visibleCount ? '' : 'none';
      }
    }

    function checkInView() {
      entries.forEach((el) => {
        if (el.style.display === 'none' || el.classList.contains('in-view')) return;
        const rect = el.getBoundingClientRect();
        if (rect.top < window.innerHeight) {
          el.classList.add('in-view');
        }
      });
    }

    const observer = new IntersectionObserver((items) => {
      items.forEach((item) => {
        if (item.isIntersecting) {
          item.target.classList.add('in-view');
        }
      });
    }, { threshold: 0.1 });

    entries.forEach((el) => observer.observe(el));

    filtersEl?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.filter-btn') as HTMLElement | null;
      if (!btn) return;
      e.preventDefault();
      filtersEl.querySelectorAll('.filter-btn').forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      currentExt = btn.dataset.ext || 'all';
      visibleCount = PAGE_SIZE;

      if (listingEl) listingEl.style.opacity = '0';
      window.setTimeout(() => {
        render();
        checkInView();
        if (listingEl) listingEl.style.opacity = '1';
      }, 150);
    });

    loadMoreBtn?.addEventListener('click', () => {
      visibleCount += PAGE_SIZE;
      render();
      checkInView();
    });

    render();
    checkInView();
  });
</script>
